{
  "name": "qa-crawler",
  "version": "0.1.0",
  "description": "Deterministic, container-ready QA crawler for web applications (Playwright + Chromium headless, YAML scenarios).",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "main": "dist/main.js",
  "bin": {
    "qa-crawler": "dist/main.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "qa": "tsx src/main.ts",
    "start": "node dist/main.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:all": "vitest run",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "demo:server": "tsx tests/fixtures/serve-demo.ts",
    "clean": "rm -rf dist reports/*.json reports/*.html screenshots/*.png"
  },
  "dependencies": {
    "@cucumber/gherkin": "42.0.1",
    "@cucumber/messages": "34.2.1",
    "playwright": "1.56.1",
    "yaml": "^2.8.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@types/node": "^22.18.6",
    "eslint": "^9.36.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.6.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.44.1",
    "vitest": "^3.2.4"
  }
}
