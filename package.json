{
  "name": "qa-crawler-monorepo",
  "version": "0.2.0",
  "description": "QA-Crawler monorepo: @qa-crawler/core (engines) and @qa-crawler/cli (npx qa-crawler). Development runs from the root; packages are built into packages/.",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "qa": "tsx src/main.ts",
    "start": "node packages/cli/bin/qa-crawler.js",
    "build": "node scripts/clean.mjs packages/core/dist && tsc -p tsconfig.build.json && node scripts/copy-assets.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:all": "vitest run",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "demo:server": "tsx tests/fixtures/serve-demo.ts",
    "clean": "node scripts/clean.mjs packages/core/dist dist-packages reports/*.json reports/*.html screenshots/*.png",
    "pack:check": "node scripts/pack-check.mjs",
    "pack": "node scripts/pack.mjs",
    "release": "node scripts/release.mjs",
    "test:packaging": "vitest run --project packaging"
  },
  "dependencies": {
    "@cucumber/gherkin": "42.0.1",
    "@cucumber/messages": "34.2.1",
    "playwright": "1.56.1",
    "typescript": "^5.9.3",
    "yaml": "^2.8.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@types/mssql": "9.1.8",
    "@types/node": "^22.18.6",
    "@types/pg": "8.15.5",
    "eslint": "^9.36.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.6.2",
    "tsx": "^4.20.6",
    "typescript-eslint": "^8.44.1",
    "vitest": "^3.2.4"
  },
  "optionalDependencies": {
    "@github/copilot-sdk": "1.0.16",
    "mssql": "12.0.0",
    "pg": "8.16.3"
  },
  "workspaces": [
    "packages/core",
    "packages/cli"
  ]
}
