<?xml version="1.0" encoding="UTF-8"?>
<project>
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.2.5</version>
  </parent>
  <groupId>com.ex</groupId>
  <artifactId>demandes-bff</artifactId>
  <version>1.0.0</version>
  <properties>
    <demandes.version>2.1.0</demandes.version>
    <generator.version>7.5.0</generator.version>
  </properties>
  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>com.ex.contrats</groupId>
        <artifactId>demandes-api</artifactId>
        <version>${demandes.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>
  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>com.ex.contrats</groupId>
      <artifactId>demandes-api</artifactId>
    </dependency>
  </dependencies>
  <build>
    <plugins>
      <plugin>
        <artifactId>maven-dependency-plugin</artifactId>
        <executions>
          <execution>
            <id>contrats</id>
            <goals><goal>unpack</goal></goals>
            <configuration>
              <artifactItems>
                <artifactItem>
                  <groupId>com.ex.contrats</groupId>
                  <artifactId>demandes-api</artifactId>
                  <outputDirectory>${project.build.directory}/contrats</outputDirectory>
                </artifactItem>
              </artifactItems>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.openapitools</groupId>
        <artifactId>openapi-generator-maven-plugin</artifactId>
        <version>${generator.version}</version>
        <executions>
          <execution>
            <id>serveur-demandes</id>
            <goals><goal>generate</goal></goals>
            <configuration>
              <inputSpec>${project.build.directory}/contrats/openapi/demandes.yaml</inputSpec>
              <generatorName>spring</generatorName>
              <apiPackage>com.ex.demandes.api</apiPackage>
              <modelPackage>com.ex.demandes.model</modelPackage>
              <configOptions>
                <interfaceOnly>true</interfaceOnly>
                <useTags>true</useTags>
              </configOptions>
            </configuration>
          </execution>
          <execution>
            <id>client-backend</id>
            <goals><goal>generate</goal></goals>
            <configuration>
              <inputSpec>${project.basedir}/src/main/resources/backend-client.json</inputSpec>
              <generatorName>java</generatorName>
              <library>resttemplate</library>
              <apiPackage>com.ex.backend.client.api</apiPackage>
              <modelPackage>com.ex.backend.client.model</modelPackage>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
