{
  "name": "@qa-crawler/core",
  "version": "0.2.0",
  "description": "QA-Crawler core: deterministic recording, replay, exploration, reasoning, recovery, OpenAPI, visual, persistence and run workflow analysis for web applications (Playwright).",
  "license": "UNLICENSED",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./cli": {
      "types": "./dist/cli/cli.d.ts",
      "default": "./dist/cli/cli.js"
    },
    "./sdk": {
      "types": "./dist/sdk/core/index.d.ts",
      "default": "./dist/sdk/core/index.js"
    },
    "./sdk/ui": {
      "types": "./dist/sdk/ui/index.d.ts",
      "default": "./dist/sdk/ui/index.js"
    },
    "./sdk/server": {
      "types": "./dist/sdk/server/index.d.ts",
      "default": "./dist/sdk/server/index.js"
    },
    "./package.json": "./package.json",
    "./dist/*": "./dist/*"
  },
  "files": [
    "dist",
    "domain-packs",
    "assets",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@cucumber/gherkin": "42.0.1",
    "@cucumber/messages": "34.2.1",
    "playwright": "1.56.1",
    "typescript": "^5.9.3",
    "yaml": "^2.8.1",
    "zod": "^4.6.7"
  },
  "optionalDependencies": {
    "@anthropic-ai/sdk": "0.131.0",
    "@github/copilot-sdk": "1.0.16",
    "mssql": "12.0.0",
    "pg": "8.16.3"
  },
  "keywords": [
    "qa",
    "playwright",
    "crawler",
    "testing",
    "e2e",
    "openapi",
    "visual-testing"
  ]
}
